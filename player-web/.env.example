# Server-only URL used by Next.js Server Components. Required in production.
ORBIT_API_URL=http://127.0.0.1:4629

# Browser URL for authenticated Player actions. Required in production.
NEXT_PUBLIC_ORBIT_API_URL=http://127.0.0.1:4629

# Public Firebase Web configuration. Defaults match the existing Orbit Player app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_FIREBASE_SYNC=true

# Local browser QA only. Leave unset in deployed environments.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Canonical deployed Player Web origin used for metadata and auth return URLs.
NEXT_PUBLIC_PLAYER_WEB_URL=http://127.0.0.1:4175
