{
  "name": "table_manager",
  "version": "0.1.15",
  "description": "Connected live poker operations platform for demand, waitlists, tables, rewards, and tournaments.",
  "author": "Orbit",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "linked:dev": "node scripts/dev-linked.cjs",
    "desktop": "npm run build && node scripts/launch-electron.cjs",
    "build": "vite build",
    "audit:module-graph": "node scripts/audit-module-graph.mjs",
    "measure:renderer-bundle": "node scripts/measure-renderer-bundle.mjs",
    "check:renderer-bundle": "node scripts/measure-renderer-bundle.mjs --check",
    "security:paths": "node scripts/check-sensitive-paths.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "download:stage": "node scripts/stage-download-site.cjs",
    "download:dev": "npm run download:stage && vite --config download-site/vite.config.mjs --host 127.0.0.1 --port 4174",
    "download:build": "vite build --config download-site/vite.config.mjs",
    "check:public-site": "node scripts/verify-public-site.mjs",
    "brand:sync": "node scripts/brand-assets.cjs --write",
    "check:brand": "node scripts/brand-assets.cjs",
    "security:dependencies": "node scripts/audit-production-dependencies.mjs",
    "check:release-controls": "node scripts/verify-release-controls.mjs",
    "api:install": "npm install --prefix apps/api --no-package-lock",
    "api:dev": "npm run dev --prefix apps/api",
    "api:start": "npm run start --prefix apps/api",
    "web:dev": "npm run dev --prefix player-web",
    "web:start": "npm run start --prefix player-web",
    "web:typecheck": "npm run typecheck --prefix player-web",
    "web:test": "npm run test --prefix player-web",
    "web:lint": "npm run lint --prefix player-web",
    "web:build": "npm run build --prefix player-web",
    "web:e2e": "node tests/e2e/player-web-smoke.mjs",
    "web:landing:parity": "node tests/e2e/player-web-landing-parity.mjs",
    "player:dev": "cd player-app && npm run start",
    "player:ios": "cd player-app && npm run ios",
    "player:android": "cd player-app && npm run android",
    "player:typecheck": "cd player-app && npm run typecheck",
    "player:rules:deploy": "cd player-app && npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "player:build:preview": "cd player-app && npx eas-cli build --profile preview",
    "player:build:production": "cd player-app && npx eas-cli build --profile production",
    "typecheck": "node scripts/typecheck.cjs",
    "typecheck:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "typecheck:electron": "tsc --project tsconfig.electron.json --noEmit",
    "typecheck:api": "npm run typecheck --prefix apps/api",
    "test": "vitest run --exclude player-web/**",
    "verify": "node scripts/verify.cjs",
    "stress:e2e": "node tests/e2e/stress-electron.mjs",
    "e2e:management": "node scripts/run-management-smoke.mjs",
    "e2e:public": "node scripts/run-public-smoke.mjs",
    "e2e:packaged": "node tests/e2e/packaged-electron-smoke.mjs",
    "capture:public-proof": "node scripts/capture-public-product-proof.mjs",
    "clubs:cleanup:stress": "node apps/api/src/cleanupStressClubs.js",
    "pilot:key": "node scripts/generate-pilot-key.cjs",
    "pilot:key:init": "node scripts/generate-pilot-key.cjs init",
    "club:members": "node scripts/firestore-club-members.cjs",
    "package:win": "node scripts/prepare-builder-dist.cjs && npm run build && electron-builder --win --dir",
    "start": "npm run desktop",
    "prepackage": "npm run build",
    "package": "electron-builder --dir",
    "predist": "node scripts/prepare-builder-dist.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/prepare-builder-dist.cjs && npm run build && electron-builder --win",
    "release:win:artifact": "node scripts/prepare-builder-dist.cjs && npm run build && electron-builder --win --publish never",
    "make": "npm run dist:win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^3.4.0",
    "firebase": "^12.13.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.orbit.desktop",
    "productName": "Orbit",
    "icon": "build/icon.ico",
    "asar": true,
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "apps/api/package.json",
      "apps/api/src/http/dataProtection.js",
      "apps/api/src/operations/dataProtection.js",
      "apps/api/src/shared/orbitCore.cjs",
      "build/icon.ico",
      "build/icon.png",
      "branding.config.json",
      "package.json",
      "!out/**",
      "!release/**",
      "!download-dist/**",
      "!download-site/public/downloads/**",
      "!download-site/downloads/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "sahusgupta",
      "repo": "orbit",
      "releaseType": "release"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "uuid": "^11.1.1",
    "vite": {
      "esbuild": "^0.28.1"
    }
  }
}
