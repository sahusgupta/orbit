# Safe local variable catalog for the React renderer and Electron desktop shell.
# Vite loads VITE_* values from a root .env file. Electron does not load .env by
# itself, so export ORBIT_* and TABLEMANAGER_* values in the shell that launches
# it. Never commit real keys or credentials.
VITE_ENABLE_FIREBASE_SYNC=false
VITE_ORBIT_LOCAL_API_URL=http://127.0.0.1:4629
ORBIT_API_URL=http://127.0.0.1:4629
ORBIT_CLIENT_API_KEY=
ORBIT_ENABLE_FIREBASE_SYNC=false
ORBIT_ENABLE_EMBEDDED_BACKEND=false
NODE_ENV=development

# Optional isolated local paths and ports.
TABLEMANAGER_BACKEND_PORT=4629
TABLEMANAGER_SYNC_HOST=127.0.0.1
TABLEMANAGER_SYNC_PORT=4629
TABLEMANAGER_USER_DATA_DIR=

# Optional analytical-report delivery. Leave blank unless explicitly testing a
# local/non-production integration with approved test credentials.
TABLEMANAGER_REPORT_ENDPOINT=
TABLEMANAGER_REPORT_EMAIL_TO=
TABLEMANAGER_SMTP_HOST=
TABLEMANAGER_SMTP_PORT=
TABLEMANAGER_SMTP_USER=
TABLEMANAGER_SMTP_PASS=
TABLEMANAGER_SMTP_FROM=

# Optional SMS integration. Use approved test credentials/numbers only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_FROM=

# Optional license signing. Do not place a production private key here.
PILOT_LICENSE_PRIVATE_KEY_PEM=
