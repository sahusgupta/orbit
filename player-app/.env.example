# EXPO_PUBLIC_* values are bundled into the client and are not secrets.
APP_ENV=development
EXPO_PUBLIC_ORBIT_API_URL=http://127.0.0.1:4629
EXPO_PUBLIC_ORBIT_LOCAL_API_URL=http://127.0.0.1:4629
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT_ID=player_premium
EXPO_PUBLIC_APPLE_PREMIUM_PRODUCT_ID=com.orbit.player.premium.monthly
EXPO_PUBLIC_ENABLE_CARD_HOUSE_CHECKOUT=false
EXPO_PUBLIC_ENABLE_PLAYER_PREMIUM=false
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=

# Native map keys are injected at build time. Use restricted development keys.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
