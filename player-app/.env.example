# EXPO_PUBLIC_* values are plaintext in the compiled client and must never be secrets.
ORBIT_APP_ENV=development
EXPO_PUBLIC_ORBIT_API_URL=http://127.0.0.1:4629
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://orbitapp-one.vercel.app/privacy
EXPO_PUBLIC_SUPPORT_URL=https://orbitapp-one.vercel.app/support
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://orbitapp-one.vercel.app/terms

# Conservative first-release policy. Production validation requires every value below.
ORBIT_V1_CARD_HOUSE_CHECKOUT_ENABLED=false
ORBIT_V1_DEMO_DATA_ENABLED=false
ORBIT_V1_PLAYER_PREMIUM_ENABLED=false
ORBIT_V1_PRIVATE_GAMES_ENABLED=false
ORBIT_V1_PUSH_NOTIFICATIONS_ENABLED=false
ORBIT_V1_SOCIAL_AUTH_ENABLED=false
ORBIT_V1_TOURNAMENT_REGISTRATION_ENABLED=false
