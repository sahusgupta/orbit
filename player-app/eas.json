{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_ORBIT_API_URL": "https://orbitapp-one.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_ORBIT_API_URL": "https://orbitapp-one.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_ORBIT_API_URL": "https://orbitapp-one.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
