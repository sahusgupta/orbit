rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(playerId) {
      return isSignedIn() && request.auth.uid == playerId;
    }

    function hasEmail() {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['email', 'email_verified'])
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function hasPhone() {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['phone_number'])
        && request.auth.token.phone_number is string;
    }

    function isClubAdmin(clubId) {
      return isSignedIn()
        && (
          (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAll(['clubId'])
            && request.auth.token.clubId is string
            && request.auth.token.clubId == clubId)
          || (request.auth.token.keys().hasAll(['clubIds'])
            && request.auth.token.clubIds is map
            && request.auth.token.clubIds.keys().hasAll([clubId])
            && request.auth.token.clubIds[clubId] == true)
        );
    }

    function doesNotChangeServerManagedBilling() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'premium',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'subscriptionStatus',
        'subscriptionCurrentPeriodEnd'
      ]);
    }

    function hasNoServerManagedBilling() {
      return !request.resource.data.keys().hasAny([
        'premium',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'subscriptionStatus',
        'subscriptionCurrentPeriodEnd'
      ]);
    }

    function isPendingPlayerRequest(clubId, requestType) {
      return request.resource.data.clubId == clubId
        && request.resource.data.type == requestType
        && request.resource.data.status == 'pending'
        && request.resource.data.id is string
        && request.resource.data.player.id is string
        && request.resource.data.player.name is string
        && request.resource.data.player.email is string
        && request.resource.data.requestedAt is string
        && request.resource.data.id.size() > 0
        && request.resource.data.player.id.size() > 0
        && request.resource.data.player.name.size() > 0;
    }

    function marksRequestAppliedOnly() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'appliedAt',
          'appliedBy',
          'syncProtocolVersion'
        ])
        && request.resource.data.status == 'applied'
        && (
          !request.resource.data.keys().hasAny(['appliedBy'])
          || request.resource.data.appliedBy is string
        );
    }

    match /clubStates/{clubId} {
      allow read: if isClubAdmin(clubId);
      allow create, update, delete: if false;

      match /membershipRequests/{requestId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.player.id);
        allow create, update, delete: if false;
      }

      match /waitlistRequests/{requestId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.player.id);
        allow create, update, delete: if false;
      }
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /games/{gameId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /players/{playerId} {
        allow read: if isClubAdmin(clubId);
        allow create, update, delete: if false;
      }

      match /memberships/{membershipId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.playerId);
        allow create, update, delete: if false;
      }

      match /waitlists/{waitlistId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.playerId);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isClubAdmin(clubId)
          || (isSignedIn()
            && resource.data.targetPlayerIds is list
            && resource.data.targetPlayerIds.size() == 1
            && resource.data.targetPlayerIds.hasAny([request.auth.uid]));
        allow create, update, delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /tournaments/{tournamentId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /tournamentRegistrations/{registrationId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /tournamentInterests/{interestId} {
        allow read: if isClubAdmin(clubId) || (isSignedIn() && resource.data.playerId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isClubAdmin(clubId) || (isSignedIn() && resource.data.playerId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /pushTokens/{playerId} {
        allow read, create, update, delete: if false;
      }

      match /membershipRequests/{requestId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.player.id);
        allow create, update, delete: if false;
      }

      match /waitlistRequests/{requestId} {
        allow read: if isClubAdmin(clubId) || isSelf(resource.data.player.id);
        allow create, update, delete: if false;
      }
    }

    match /players/{playerId} {
      allow create: if isSelf(playerId)
        && !playerDeletionBlocked(playerId)
        && hasNoServerManagedBilling()
        && request.resource.data.keys().hasOnly(playerWritableFields())
        && validSelfPlayerDocument(playerId);
      allow update: if isSelf(playerId)
        && !playerDeletionBlocked(playerId)
        && doesNotChangeServerManagedBilling()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(playerWritableFields())
        && validSelfPlayerDocument(playerId);
      allow read: if isSelf(playerId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /games/{rootDocument} {
      allow read: if false;
      allow create, update, delete: if false;

      match /{clubName}/{gameId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /privateGames/{gameId} {
      allow read, create: if false;
      allow update, delete: if false;
    }

    match /playerDeletionBlocks/{playerId} {
      allow read, write: if false;
    }

    function playerWritableFields() {
      return [
        'id', 'uid', 'name', 'email', 'phone', 'homeLocation',
        'searchRadiusMiles', 'preferredGameIds', 'favoriteClubIds',
        'preferredStakes', 'typicalAvailability', 'adultDeclaredAt',
        'adultDeclarationVersion', 'updatedAt'
      ];
    }

    function playerDeletionBlocked(playerId) {
      return exists(/databases/$(database)/documents/playerDeletionBlocks/$(playerId));
    }

    function validSelfPlayerDocument(playerId) {
      return request.resource.data.id == playerId
        && request.resource.data.uid == playerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && (
          (hasEmail() && request.resource.data.email == request.auth.token.email)
          || (!hasEmail()
            && hasPhone()
            && request.resource.data.email == ''
            && request.resource.data.phone is string
            && request.resource.data.phone == request.auth.token.phone_number)
        )
        && request.resource.data.preferredGameIds is list
        && request.resource.data.preferredGameIds.size() <= 50
        && request.resource.data.adultDeclaredAt is string
        && request.resource.data.adultDeclaredAt.size() >= 20
        && request.resource.data.adultDeclaredAt.size() <= 40
        && request.resource.data.adultDeclaredAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$')
        && request.resource.data.adultDeclarationVersion == 'v1'
        && (!request.resource.data.keys().hasAny(['phone'])
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!request.resource.data.keys().hasAny(['homeLocation'])
          || (request.resource.data.homeLocation is string && request.resource.data.homeLocation.size() <= 240))
        && (!request.resource.data.keys().hasAny(['searchRadiusMiles'])
          || ((request.resource.data.searchRadiusMiles is int || request.resource.data.searchRadiusMiles is float)
            && request.resource.data.searchRadiusMiles >= 1
            && request.resource.data.searchRadiusMiles <= 500))
        && (!request.resource.data.keys().hasAny(['favoriteClubIds'])
          || (request.resource.data.favoriteClubIds is list && request.resource.data.favoriteClubIds.size() <= 100))
        && (!request.resource.data.keys().hasAny(['preferredStakes'])
          || (request.resource.data.preferredStakes is string && request.resource.data.preferredStakes.size() <= 80))
        && (!request.resource.data.keys().hasAny(['typicalAvailability'])
          || (request.resource.data.typicalAvailability is string && request.resource.data.typicalAvailability.size() <= 240))
        && request.resource.data.updatedAt is timestamp;
    }

    // Firebase Admin is the only reader/writer for every unmatched collection,
    // including Orbit's authoritative state, outbox, audit, and telemetry data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
