{
  "name": "orbit-player",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules"
      ]
    }
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "build:testflight": "eas build --platform ios --profile production",
    "submit:testflight": "node scripts/submit-testflight.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.37",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-constants": "18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "15.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-doctor": "1.20.4",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.5",
    "js-yaml@^3.0.0": "3.15.1",
    "js-yaml@^4.0.0": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "shell-quote": "^1.8.4",
    "uuid": "^11.1.1"
  }
}
