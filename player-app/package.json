{
  "name": "orbit-player",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules"
      ]
    }
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "node scripts/pin-eas-npm.cjs",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "build:testflight": "eas build --platform ios --profile production",
    "submit:testflight": "node scripts/submit-testflight.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^2.0.1": "2.1.4",
    "brace-expansion@^5.0.2": "5.0.9",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.6",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "shell-quote": "^1.8.4",
    "uuid": "^11.1.1"
  }
}
