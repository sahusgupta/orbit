# Local API variable catalog. The API does not load .env by itself; export these
# values in the launching shell or configure them in an approved local runner.
# Access values must remain local and must never be copied from production.
API_HOST=127.0.0.1
API_PORT=4629
NODE_ENV=development
# Unit-test-only Firestore fake. Hosted runtimes reject this setting.
ORBIT_FIRESTORE_MEMORY=false
# Explicit local-only bypass; never enable in production or behind a proxy.
ORBIT_ALLOW_INSECURE_LOOPBACK_AUTH=false
# JSON array of scoped, tenant-bound, expiring machine credentials. Keep values
# in the deployment secret provider, not this file or browser storage.
ORBIT_MACHINE_CREDENTIALS_JSON=[]
# Legacy client key use is disabled unless explicitly enabled for migration.
ORBIT_ALLOW_LEGACY_CLIENT_KEY=false
ORBIT_CLIENT_API_KEY=
ORBIT_CLIENT_ACCOUNT_KEY=
ORBIT_OWNER_API_KEY=
ORBIT_DASHBOARD_PASSWORD=
ORBIT_DASHBOARD_SESSION_SECRET=
ORBIT_PHONE_CHALLENGE_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ORBIT_ACCOUNT_DELETION_POLICY_JSON=
ORBIT_DELETION_PSEUDONYM_SECRET=
ORBIT_DASHBOARD_SESSION_MINUTES=30
ORBIT_ALLOWED_ORIGINS=
ORBIT_TRUST_PROXY=
ORBIT_SSE_MAX_CONNECTIONS=50
ORBIT_LOG_HASH_SECRET=
ORBIT_STORE_ERROR_STACKS=false
ORBIT_LICENSE_PUBLIC_KEY_PEM=

# Required Firebase Admin configuration for the authoritative datastore.
# Configure at most one approved credential mechanism; never paste credential
# JSON into this template. Local emulator use may set FIRESTORE_EMULATOR_HOST.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=
# Firebase web API key used only to ask Identity Toolkit to send its configured
# password-reset email. This is configuration, not an Admin credential.
FIREBASE_WEB_API_KEY=

# Optional Stripe, Identity, and RevenueCat integrations. Test mode only during
# ordinary engineering work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_VERIFICATION_FLOW_ID=
ORBIT_IDENTITY_RETURN_URL=orbitplayer://identity-complete
ORBIT_IDENTITY_REQUIRE_SELFIE=true
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=player_premium
ORBIT_PAYMENT_SUCCESS_URL=
ORBIT_PAYMENT_CANCEL_URL=
ORBIT_DAY_PASS_PRICE_CENTS=1000
ORBIT_MONTHLY_MEMBERSHIP_PRICE_CENTS=3500
ORBIT_FIVE_HOUR_TIME_PRICE_CENTS=
ORBIT_PAYMENT_CURRENCY=usd
